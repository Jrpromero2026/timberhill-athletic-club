# Performance Operations — environment configuration
#
# Copy this file to .env.local and fill in the values from your dedicated
# Supabase project (Project Settings → API). This project must use its OWN
# Supabase project — never point it at a Supabase project belonging to any
# other application.
#
# Never commit .env.local. Never paste these values into docs, logs, or chat.

# --- Supabase (required for database-backed features) ---
# Public URL of the Supabase project (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable (anon) key (safe to expose to the browser; RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key. SERVER ONLY. Bypasses RLS — required only for admin
# scripts and seeding. NEVER prefix with NEXT_PUBLIC_. Leave unset in
# environments that do not need it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ---
# Base URL of the app (used by Playwright and absolute-URL generation).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Explicit development-only switch for the offline UI preview. The preview
# renders ONLY when Supabase is NOT configured AND this is "true" — it can
# never activate silently when real environment variables are present.
NEXT_PUBLIC_DEV_OFFLINE_PREVIEW=false

# --- PT Director (the AI agent) ---
# OpenAI key for the Director's tool-calling loop. SERVER ONLY — never
# prefix with NEXT_PUBLIC_, or it ships to every browser that loads the site.
#
# The name is exact: OPENAI_API_KEY, no underscore between OPEN and AI.
# `isDirectorConfigured()` reads this and nothing else, so a near-miss like
# OPEN_AI_KEY leaves the Director reporting "not configured" with no clue why.
#
# Leave unset and the Director page says so plainly and renders no chat. The
# rest of the application is unaffected.
OPENAI_API_KEY=

# Optional model override. Defaults to gpt-5.1 when unset. Set it only if
# the account's key does not have access to that model.
TIMBERHILL_PT_DIRECTOR_MODEL=
